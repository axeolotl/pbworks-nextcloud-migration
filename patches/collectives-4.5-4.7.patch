+	/**
+	 * Find the page ID for a relative link, resolved against the directory of the linking file
+	 */
+	private function lookupPath(string $fromDirectory, string $sanitizedHref): ?int {
+		$realFrom = realpath($fromDirectory);
+		$base = $realFrom !== false ? $realFrom : $fromDirectory;
+		$target = self::normalizePath($base . '/' . rawurldecode($sanitizedHref));
+		$candidates = [$target];
+		if (!str_ends_with(strtolower($target), '.md')) {
+			$candidates[] = $target . '.md';
+		}
+		foreach ($candidates as $candidate) {
+			if (isset($this->pathLookup[$candidate])) {
+				return $this->pathLookup[$candidate];
+			}
+		}
+		return null;
+	}
