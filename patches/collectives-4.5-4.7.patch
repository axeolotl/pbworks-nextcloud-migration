+	/**
+	 * Replace an inline link destination in the raw Markdown.
+	 * The parser returns the destination percent-encoded, so the raw text may contain
+	 * either the encoded or the decoded form, optionally in angle brackets and with a title.
+	 */
+	private static function replaceDestination(string $href, string $newHref, string &$content): int {
+		// Preserve code blocks, HTML blocks and inline code byte-for-byte.
+		$environment = new \League\CommonMark\Environment\Environment();
+		$environment->addExtension(new \League\CommonMark\Extension\CommonMark\CommonMarkCoreExtension());
+		$document = (new \League\CommonMark\Parser\MarkdownParser($environment))->parse($content);
+		$walker = $document->walker();
+		$lines = explode("\n", $content);
+		$protected = [];
+		while ($event = $walker->next()) {
+			$node = $event->getNode();
+			if ($event->isEntering() && (
+				$node instanceof \League\CommonMark\Extension\CommonMark\Node\Block\FencedCode
+				|| $node instanceof \League\CommonMark\Extension\CommonMark\Node\Block\IndentedCode
+				|| $node instanceof \League\CommonMark\Extension\CommonMark\Node\Block\HtmlBlock
+			)) {
+				for ($line = $node->getStartLine() - 1; $line < $node->getEndLine(); $line++) {
+					$protected[$line] = true;
+				}
+			}
+		}
+		$saved = [];
+		$prefix = 'MIGRATION_LITERAL_' . bin2hex(random_bytes(16)) . '_';
+		foreach (array_keys($protected) as $line) {
+			$key = $prefix . count($saved);
+			$saved[$key] = $lines[$line];
+			$lines[$line] = $key;
+		}
+		$working = implode("\n", $lines);
+		$working = preg_replace_callback('/(?<!`)(`+)(?!`)([\s\S]*?)(?<!`)\1(?!`)/',
+			static function ($m) use (&$saved, $prefix) {
+				$key = $prefix . count($saved);
+				$saved[$key] = $m[0];
+				return $key;
+			}, $working);
+		$total = self::replaceDestinationRaw($href, $newHref, $working);
+		$content = strtr($working, $saved);
+		return $total;
+	}
+
+	private static function replaceDestinationRaw(string $href, string $newHref, string &$content): int {
+		$forms = array_unique([$href, rawurldecode($href)]);
+		$total = 0;
+		foreach ($forms as $form) {
+			$quoted = preg_quote($form, '/');
+			$pattern = '/\]\(\s*(?:<' . $quoted . '>|' . $quoted . ')(?=\s|\))/u';
+			$result = preg_replace_callback($pattern, static fn () => '](' . $newHref, $content, -1, $count);
+			if ($result !== null) {
+				$content = $result;
+				$total += $count;
+			}
+			// Reference link definitions: `[label]: destination "title"`
+			$pattern = '/^( {0,3}\[[^\]\n]+\]:[ \t]*)(?:<' . $quoted . '>|' . $quoted . ')(?=\s|$)/mu';
+			$result = preg_replace_callback($pattern, static fn ($m) => $m[1] . $newHref, $content, -1, $count);
+			if ($result !== null) {
+				$content = $result;
+				$total += $count;
+			}
+		}
+		return $total;
 	}
 
