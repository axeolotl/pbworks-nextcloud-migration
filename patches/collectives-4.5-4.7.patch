+	/**
+	 * Lexically normalize a path (resolve `.` and `..`, collapse separators)
+	 */
+	private static function normalizePath(string $path): string {
+		$isAbsolute = str_starts_with($path, '/');
+		$parts = [];
+		foreach (explode('/', $path) as $segment) {
+			if ($segment === '' || $segment === '.') {
+				continue;
+			}
+			if ($segment === '..') {
+				if ($parts !== [] && end($parts) !== '..') {
+					array_pop($parts);
+				} elseif (!$isAbsolute) {
+					$parts[] = '..';
+				}
+				continue;
+			}
+			$parts[] = $segment;
+		}
+		$normalized = ($isAbsolute ? '/' : '') . implode('/', $parts);
+		if (class_exists(\Normalizer::class)) {
+			$nfc = \Normalizer::normalize($normalized, \Normalizer::FORM_C);
+			if ($nfc !== false) {
+				$normalized = $nfc;
+			}
+		}
+		return $normalized;
+	}
+
+	private function registerPath(string $path, int $pageId): void {
+		$realPath = realpath($path);
+		$key = self::normalizePath($realPath !== false ? $realPath : $path);
+		$this->pathLookup[$key] = $pageId;
+		$lower = mb_strtolower($key, 'UTF-8');
+		// null marks an ambiguous case-insensitive match
+		$this->pathLookupLower[$lower] = array_key_exists($lower, $this->pathLookupLower) && $this->pathLookupLower[$lower] !== $pageId
+			? null
+			: $pageId;
+	}
